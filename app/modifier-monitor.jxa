// Run by the system JavaScript for Automation interpreter, without a compiler.
// Read only modifier flags. Never inspect key codes, typed text or event payloads.
ObjC.import('Foundation');
ObjC.import('CoreGraphics');
function run(argv) {
  var output = $.NSFileHandle.fileHandleWithStandardOutput;
  var previous = -1;
  while (true) {
    // Combined state of hardware devices in the current login session.
    var flags = Number($.CGEventSourceFlagsState(0));
    if (flags !== previous) {
      var line = $(String(flags) + '\n').dataUsingEncoding($.NSUTF8StringEncoding);
      output.writeData(line);
      previous = flags;
      if (argv[0] === '--probe') return;
    }
    $.NSThread.sleepForTimeInterval(0.015);
  }
}
